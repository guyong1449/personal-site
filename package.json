{
  "name": "personal-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "build:content": "pnpm --dir tools/site-builder build",
    "test:content": "pnpm --dir tools/site-builder test",
    "lint:web": "pnpm --dir apps/web lint",
    "test:web": "pnpm --dir apps/web test",
    "export:content": "pnpm --dir tools/publisher export -- --config config.yaml",
    "publish:file": "pnpm --dir tools/publisher export -- --config config.yaml --file",
    "sync:assets": "node apps/web/scripts/sync-public-assets.mjs",
    "generate:rss": "node apps/web/scripts/generate-rss.js",
    "prebuild:web": "pnpm build:content && pnpm sync:assets && pnpm generate:rss",
    "publish-server": "node tools/publish-server.js",
    "studio": "node tools/studio/server.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
